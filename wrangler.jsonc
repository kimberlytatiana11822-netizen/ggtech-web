{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ggtech-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejss_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ggtech-web"
    }
  ],
  "observability": {
    "enabled": true
  }
}